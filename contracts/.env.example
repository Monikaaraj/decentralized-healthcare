# Contracts deployment environment — DO NOT COMMIT WITH REAL VALUES
# Copy this file to .env and fill in your values

# Your deployer wallet private key (WITHOUT 0x prefix)
PRIVATE_KEY=your_private_key_here

# Optional: override default public RPC URLs
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Block explorer API keys (optional, for contract verification)
ETHERSCAN_API_KEY=
POLYGONSCAN_API_KEY=
