{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "devCommand": "npm run dev -- --webpack -p 3001",
  "env": {
    "NEXT_PUBLIC_CONTRACT_ADDRESS": "@aegis_contract_address",
    "NEXT_PUBLIC_MAIN_APP_URL": "@aegis_main_app_url"
  }
}
